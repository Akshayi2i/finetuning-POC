{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Signed commercial auto application package extraction",
  "description": "Floor, not ceiling: these sections must be present, and extra keys are allowed everywhere so that content the structure does not anticipate is kept rather than dropped.",
  "type": "object",
  "required": [
    "document_metadata",
    "general_policy_information",
    "coverages_premium_and_payment_information",
    "business_and_owner_information",
    "business_usage",
    "business_filings",
    "additional_coverages_for_your_business",
    "vehicles",
    "stated_amount_note",
    "business_owner_and_driver_information",
    "drivers_disclosure",
    "additional_interests_lienholders",
    "authorized_representatives",
    "disclosures",
    "application_signature_page",
    "new_york_information_and_option_form",
    "auto_pay_enrollment_letter",
    "signatures_summary",
    "data_quality_notes"
  ],
  "additionalProperties": true,
  "properties": {
    "document_metadata": {
      "type": "object"
    },
    "general_policy_information": {
      "type": "object"
    },
    "coverages_premium_and_payment_information": {
      "type": "object"
    },
    "business_and_owner_information": {
      "type": "array"
    },
    "business_usage": {
      "type": "array"
    },
    "business_filings": {
      "type": "array"
    },
    "additional_coverages_for_your_business": {
      "type": "object"
    },
    "vehicles": {
      "type": "array"
    },
    "stated_amount_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "business_owner_and_driver_information": {
      "type": "array"
    },
    "drivers_disclosure": {
      "type": "object"
    },
    "additional_interests_lienholders": {
      "type": "array"
    },
    "authorized_representatives": {
      "type": "array"
    },
    "disclosures": {
      "type": "object"
    },
    "application_signature_page": {
      "type": "object"
    },
    "new_york_information_and_option_form": {
      "type": "object"
    },
    "auto_pay_enrollment_letter": {
      "type": "object"
    },
    "signatures_summary": {
      "type": "object"
    },
    "data_quality_notes": {
      "type": "array"
    },
    "additional_content": {
      "description": "Anything present in the document that the sections above do not cover.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {}
        },
        "required": [
          "page",
          "label",
          "content"
        ],
        "additionalProperties": true
      }
    }
  }
}
