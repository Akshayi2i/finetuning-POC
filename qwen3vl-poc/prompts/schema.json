{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Commercial auto policy declaration extraction",
  "description": "Floor, not ceiling: these sections must be present, and extra keys are allowed everywhere so content the structure does not anticipate is kept rather than dropped.",
  "type": "object",
  "required": [
    "document_type",
    "carrier_name",
    "transaction",
    "named_insured",
    "contact_info",
    "line_of_business",
    "additional_interests",
    "states",
    "vehicles",
    "drivers",
    "commercial_policy_information",
    "locations",
    "pay_plan",
    "disclaimer",
    "document_metadata"
  ],
  "additionalProperties": true,
  "properties": {
    "document_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "carrier_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "transaction": {
      "type": "object"
    },
    "named_insured": {
      "type": "object"
    },
    "contact_info": {
      "type": "array"
    },
    "line_of_business": {
      "type": "object"
    },
    "additional_interests": {
      "type": "array"
    },
    "states": {
      "type": "array"
    },
    "vehicles": {
      "type": "array"
    },
    "drivers": {
      "type": "array"
    },
    "commercial_policy_information": {
      "type": "object"
    },
    "locations": {
      "type": "array"
    },
    "pay_plan": {
      "type": "object"
    },
    "disclaimer": {
      "type": [
        "string",
        "null"
      ]
    },
    "document_metadata": {
      "type": "object"
    },
    "additional_content": {
      "description": "Anything present in the document that the sections above do not cover.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "page": {
            "type": [
              "integer",
              "null"
            ]
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "content": {}
        },
        "required": [
          "page",
          "label",
          "content"
        ],
        "additionalProperties": true
      }
    }
  }
}
